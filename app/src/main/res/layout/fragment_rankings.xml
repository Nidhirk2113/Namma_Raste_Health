<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/brand_black">

    <!-- Header info -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="INFRASTRUCTURE QUALITY RANKINGS"
        android:textSize="12sp"
        android:textColor="@color/brand_yellow"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        android:padding="20dp"/>

    <!-- Empty state -->
    <LinearLayout
        android:id="@+id/layoutRankingsEmpty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No Data Available"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_white"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Register assets to generate rankings"
            android:textSize="14sp"
            android:textColor="@color/colorTextSecondary"
            android:layout_marginTop="8dp"/>

    </LinearLayout>

    <!-- Rankings RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvRankings"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="4dp"
        android:paddingBottom="100dp"
        android:clipToPadding="false"/>

</LinearLayout>