<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_black"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="REGISTER ASSET"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/text_white"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Onboard new road infrastructure to the monitoring system"
            android:textSize="13sp"
            android:textColor="@color/colorTextSecondary"
            android:layout_marginBottom="24dp"/>

        <!-- ── ROAD INFORMATION SECTION ── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ASSET IDENTIFICATION"
            android:textSize="12sp"
            android:textColor="@color/brand_yellow"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:layout_marginBottom="12dp"
            android:paddingStart="4dp"/>

        <!-- Road Code -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilRoadCode"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="System Asset ID"
            app:boxStrokeColor="@color/brand_yellow"
            app:hintTextColor="@color/brand_yellow"
            app:boxBackgroundColor="@color/surface_grey"
            android:layout_marginBottom="12dp">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etRoadCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:textColor="@color/text_white"
                android:imeOptions="actionNext"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Road Name -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilRoadName"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Designated Name"
            app:boxStrokeColor="@color/brand_yellow"
            app:hintTextColor="@color/brand_yellow"
            app:boxBackgroundColor="@color/surface_grey"
            android:layout_marginBottom="12dp">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etRoadName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapWords"
                android:textColor="@color/text_white"
                android:imeOptions="actionNext"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Length + Construction Year (side by side) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilLength"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Length (km)"
                app:boxStrokeColor="@color/brand_yellow"
                app:hintTextColor="@color/brand_yellow"
                app:boxBackgroundColor="@color/surface_grey"
                android:layout_marginEnd="8dp">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etLength"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:textColor="@color/text_white"
                    android:imeOptions="actionNext"/>
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilConstructionYear"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Built Year"
                app:boxStrokeColor="@color/brand_yellow"
                app:hintTextColor="@color/brand_yellow"
                app:boxBackgroundColor="@color/surface_grey">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etConstructionYear"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:textColor="@color/text_white"
                    android:imeOptions="actionNext"/>
            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

        <!-- District + Taluka (side by side) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilDistrict"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="District"
                app:boxStrokeColor="@color/brand_yellow"
                app:hintTextColor="@color/brand_yellow"
                app:boxBackgroundColor="@color/surface_grey"
                android:layout_marginEnd="8dp">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDistrict"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapWords"
                    android:textColor="@color/text_white"
                    android:imeOptions="actionNext"/>
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilTaluka"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Taluka"
                app:boxStrokeColor="@color/brand_yellow"
                app:hintTextColor="@color/brand_yellow"
                app:boxBackgroundColor="@color/surface_grey">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etTaluka"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapWords"
                    android:textColor="@color/text_white"
                    android:imeOptions="actionNext"/>
            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

        <!-- Hobli + Pincode (side by side) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilHobli"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Hobli / Ward"
                app:boxStrokeColor="@color/brand_yellow"
                app:hintTextColor="@color/brand_yellow"
                app:boxBackgroundColor="@color/surface_grey"
                android:layout_marginEnd="8dp">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etHobli"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapWords"
                    android:textColor="@color/text_white"
                    android:imeOptions="actionNext"/>
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPincode"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Pincode"
                app:boxStrokeColor="@color/brand_yellow"
                app:hintTextColor="@color/brand_yellow"
                app:boxBackgroundColor="@color/surface_grey">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPincode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLength="6"
                    android:textColor="@color/text_white"
                    android:imeOptions="actionNext"/>
            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

        <!-- Scheme + Warranty End (side by side) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilScheme"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Scheme"
                app:boxStrokeColor="@color/brand_yellow"
                app:hintTextColor="@color/brand_yellow"
                app:boxBackgroundColor="@color/surface_grey"
                android:layout_marginEnd="8dp">

                <AutoCompleteTextView
                    android:id="@+id/actvScheme"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_white"
                    android:inputType="none"/>
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilWarrantyEnd"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Warranty End"
                app:boxStrokeColor="@color/brand_yellow"
                app:hintTextColor="@color/brand_yellow"
                app:boxBackgroundColor="@color/surface_grey">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etWarrantyEnd"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:textColor="@color/text_white"
                    android:imeOptions="actionNext"/>
            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

        <!-- ── CONTRACTOR SECTION ── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MAINTENANCE AUTHORITY"
            android:textSize="12sp"
            android:textColor="@color/brand_yellow"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:paddingStart="4dp"/>

        <!-- Contractor Name -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilContractorName"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Contractor Entity Name"
            app:boxStrokeColor="@color/brand_yellow"
            app:hintTextColor="@color/brand_yellow"
            app:boxBackgroundColor="@color/surface_grey"
            android:layout_marginBottom="12dp">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etContractorName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapWords"
                android:textColor="@color/text_white"
                android:imeOptions="actionNext"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- License + Phone (side by side) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="32dp">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilLicense"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="License ID"
                app:boxStrokeColor="@color/brand_yellow"
                app:hintTextColor="@color/brand_yellow"
                app:boxBackgroundColor="@color/surface_grey"
                android:layout_marginEnd="8dp">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etLicense"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:textColor="@color/text_white"
                    android:imeOptions="actionNext"/>
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPhone"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Contact Phone"
                app:boxStrokeColor="@color/brand_yellow"
                app:hintTextColor="@color/brand_yellow"
                app:boxBackgroundColor="@color/surface_grey">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPhone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="phone"
                    android:textColor="@color/text_white"
                    android:imeOptions="actionDone"/>
            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

        <!-- Save Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveRoad"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="AUTHORIZE ASSET ENTRY"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/brand_black"
            app:backgroundTint="@color/brand_yellow"
            app:cornerRadius="20dp"
            android:layout_marginBottom="40dp"/>

    </LinearLayout>
</ScrollView>