<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/surface_grey"
    app:strokeWidth="1dp"
    app:strokeColor="#2A2A2A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <!-- Status indicator -->
        <View
            android:id="@+id/viewStatusDot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/bg_status_dot"
            android:layout_marginEnd="16dp"/>

        <!-- Text info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvRecentDamageType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pothole"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_white"/>

            <TextView
                android:id="@+id/tvRecentRoadName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Road Name"
                android:textSize="12sp"
                android:textColor="@color/colorTextSecondary"
                android:layout_marginTop="2dp"/>

        </LinearLayout>

        <!-- Time -->
        <TextView
            android:id="@+id/tvRecentTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2h ago"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/brand_yellow"/>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>